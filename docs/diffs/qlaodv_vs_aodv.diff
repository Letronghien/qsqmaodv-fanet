+// ============================================================================
+// QL-AODV (Ateya et al., Future Internet 17(10):473, 2025) — reconstruction
+// ============================================================================
+void
+RoutingProtocol::QlSampleBuffer()
+{
+    // RequestQueue occupancy in percent of its capacity (Sec. 3.1)
+    double occ = (m_maxQueueLen > 0) ? 100.0 * m_queue.GetSize() / m_maxQueueLen : 0.0;
+    m_bufSamples.push_back(std::min(100.0, occ));
+    size_t n = std::max<size_t>(1, static_cast<size_t>(m_qlBufWindow.GetSeconds() /
+                                                       m_qlBufSample.GetSeconds() + 0.5));
+    while (m_bufSamples.size() > n) m_bufSamples.pop_front();
+    m_bufSampleEvent = Simulator::Schedule(m_qlBufSample, &RoutingProtocol::QlSampleBuffer, this);
+}
+
+double
+RoutingProtocol::QlBufMean() const
+{
+    if (m_bufSamples.empty()) return 0.0;
+    double s = 0.0;
+    for (double v : m_bufSamples) s += v;
+    return s / m_bufSamples.size();
+}
+
+double
+RoutingProtocol::QlBufMax() const
+{
+    double m = 0.0;
+    for (double v : m_bufSamples) m = std::max(m, v);
+    return m;
+}
+
+RoutingProtocol::QlState
+RoutingProtocol::QlMakeState(const RrepEntry& e) const
+{
+    // Eq. 2-4 with B_node_max% = 100 %; each component discretised in 0.1 steps (0..10)
+    double h = std::max<uint32_t>(1, e.hop);
+    double hn = std::min(1.0, h / m_qlHmax);
+    double bavg = std::min(1.0, (e.totalBuf / h) / 100.0);
+    double bmax = std::min(1.0, e.maxBuf / 100.0);
+    auto bin = [](double x) { return static_cast<uint32_t>(std::lround(x * 10.0)); };
+    return bin(hn) * 121 + bin(bavg) * 11 + bin(bmax);
+}
+
+double&
+RoutingProtocol::QlQ(Ipv4Address dst, QlState s, uint32_t a)
+{
+    auto& v = m_qTable[dst][s];
+    if (v.size() < m_qlMaxRoutes) v.resize(m_qlMaxRoutes, 0.0);   // Q initialised to 0
+    return v[a];
+}
+
+double
+RoutingProtocol::QlMaxNext(Ipv4Address dst)
+{
+    // max over the current candidate routes of D (Algorithm 3, step 2)
+    double best = 0.0;
+    bool any = false;
+    for (const auto& c : m_multiRoutes[dst])
+    {
+        double q = QlQ(dst, c.state, c.routeId);
+        if (!any || q > best) { best = q; any = true; }
+    }
+    return any ? best : 0.0;
+}
+
+void
+RoutingProtocol::QlCollect(Ipv4Address dst, const RrepEntry& e)
+{
+    m_rrepBuffer[dst].push_back(e);
+    if (!m_rrepTimer[dst].IsPending())
+    {
+        m_rrepTimer[dst] = Simulator::Schedule(m_qlRrepWait,
+                                               &RoutingProtocol::QlProcessCollectedRreps, this, dst);
+    }
+}
+
+void
+RoutingProtocol::QlProcessCollectedRreps(Ipv4Address dst)
+{
+    auto& buf = m_rrepBuffer[dst];
+    if (buf.empty()) return;
+    // Algorithm 2: sort by hop count, keep the best MAX_ROUTES, compute states
+    std::stable_sort(buf.begin(), buf.end(),
+                     [](const RrepEntry& a, const RrepEntry& b) { return a.hop < b.hop; });
+    std::vector<Candidate> cands;
+    for (uint32_t i = 0; i < buf.size() && i < m_qlMaxRoutes; ++i)
+    {
+        Candidate c;
+        c.state = QlMakeState(buf[i]);
+        c.routeId = i;
+        c.rrep = buf[i];
+        QlQ(dst, c.state, c.routeId);   // initialise if absent
+        cands.push_back(c);
+    }
+    m_multiRoutes[dst] = cands;
+    // epsilon-greedy
+    size_t pick = 0;
+    if (m_uniformRandomVariable->GetValue(0.0, 1.0) < m_ql_epsilon)
+    {
+        pick = static_cast<size_t>(m_uniformRandomVariable->GetInteger(0, cands.size() - 1));
+    }
+    else
+    {
+        double best = -1e300;
+        for (size_t i = 0; i < cands.size(); ++i)
+        {
+            double q = QlQ(dst, cands[i].state, cands[i].routeId);
+            if (q > best) { best = q; pick = i; }
+        }
+    }
+    m_ql_epsilon = std::max(m_qlEpsilonMin, m_ql_epsilon * m_qlEpsilonDecay);
+    const Candidate& sel = cands[pick];
+    m_selected[dst] = sel;
+    m_lastSelection[dst] = Simulator::Now();
+    m_qlStats.selections++;
+    m_qlStats.candidatesSum += cands.size();
+    // install the selected route in the main routing table
+    RoutingTableEntry newEntry(/*dev=*/sel.rrep.dev,
+                               /*dst=*/dst,
+                               /*vSeqNo=*/true,
+                               /*seqNo=*/sel.rrep.seqNo,
+                               /*iface=*/sel.rrep.iface,
+                               /*hops=*/sel.rrep.hop,
+                               /*nextHop=*/sel.rrep.nextHop,
+                               /*lifetime=*/sel.rrep.lifeTime);
+    RoutingTableEntry existing;
+    if (m_routingTable.LookupRoute(dst, existing))
+    {
+        newEntry.SetFlag(VALID);
+        m_routingTable.Update(newEntry);
+    }
+    else
+    {
+        m_routingTable.AddRoute(newEntry);
+    }
+    auto t = m_addressReqTimer.find(dst);
+    if (t != m_addressReqTimer.end())
+    {
+        t->second.Cancel();
+        m_addressReqTimer.erase(t);
+    }
+    buf.clear();
+    RoutingTableEntry toDst;
+    if (m_routingTable.LookupValidRoute(dst, toDst))
+    {
+        SendPacketFromQueue(dst, toDst.GetRoute());
+    }
+}
+
+void
+RoutingProtocol::QlRecordDecision(Ipv4Address dst, uint64_t uid)
+{
+    auto it = m_selected.find(dst);
+    if (it == m_selected.end()) return;
+    m_pendingFeedback[uid] = PendingFb{dst, it->second.state, it->second.routeId, Simulator::Now()};
+}
+
+void
+RoutingProtocol::QlFeedback(uint64_t uid, double reward)
+{
+    auto it = m_pendingFeedback.find(uid);
+    if (it == m_pendingFeedback.end()) return;
+    const PendingFb pf = it->second;
+    m_pendingFeedback.erase(it);
+    // Algorithm 3 / Eq. 6
+    double& q = QlQ(pf.dst, pf.state, pf.action);
+    double maxNext = QlMaxNext(pf.dst);
+    q = q + m_qlAlpha * (reward + m_qlGamma * maxNext - q);
+    if (reward > 0) m_qlStats.fbAck++; else m_qlStats.fbFail++;
+}
+
+void
+RoutingProtocol::QlPurgePending()
+{
+    Time now = Simulator::Now();
+    std::vector<uint64_t> expired;
+    for (const auto& kv : m_pendingFeedback)
+        if (now - kv.second.t0 > m_qlFbTimeout) expired.push_back(kv.first);
+    for (uint64_t uid : expired)
+    {
+        m_qlStats.fbTimeout++;
+        QlFeedback(uid, -1.0);   // "no ACK within a specified timeout" = failure
+    }
+    m_pendingEvent = Simulator::Schedule(MilliSeconds(250), &RoutingProtocol::QlPurgePending, this);
+}
+
+void
+RoutingProtocol::QlReplyToDuplicate(const RreqHeader& rreq, Ipv4Address receiver, Ipv4Address src)
+{
+    auto& done = m_dupReplied[std::make_pair(rreq.GetOrigin(), rreq.GetId())];
+    if (done.count(src) || done.size() >= m_qlMaxRoutes) return;
+    done.insert(src);
+    int32_t ifIdx = m_ipv4->GetInterfaceForAddress(receiver);
+    // make sure the neighbour is in the routing table (the duplicate skipped that step)
+    RoutingTableEntry toNeighbor;
+    if (!m_routingTable.LookupRoute(src, toNeighbor))
+    {
+        RoutingTableEntry e(m_ipv4->GetNetDevice(ifIdx), src, false, rreq.GetOriginSeqno(),
+                            m_ipv4->GetAddress(ifIdx, 0), 1, src, m_activeRouteTimeout);
+        m_routingTable.AddRoute(e);
+    }
+    RrepHeader rrepHeader(/*prefixSize=*/0,
+                          /*hopCount=*/0,
+                          /*dst=*/rreq.GetDst(),
+                          /*dstSeqNo=*/m_seqNo,
+                          /*origin=*/rreq.GetOrigin(),
+                          /*lifetime=*/m_myRouteTimeout);
+    rrepHeader.SetTotalBuffer(static_cast<uint32_t>(std::lround(QlBufMean())));
+    rrepHeader.SetMaxBuffer(static_cast<uint32_t>(std::lround(QlBufMax())));
+    Ptr<Packet> packet = Create<Packet>();
+    SocketIpTtlTag tag;
+    tag.SetTtl(rreq.GetHopCount() + 1);
+    packet->AddPacketTag(tag);
+    packet->AddHeader(rrepHeader);
+    TypeHeader tHeader(QLAODVTYPE_RREP);
+    packet->AddHeader(tHeader);
+    Ptr<Socket> socket = FindSocketWithInterfaceAddress(m_ipv4->GetAddress(ifIdx, 0));
+    if (!socket) return;
+    socket->SendTo(packet, 0, InetSocketAddress(src, QLAODV_PORT));
+    m_qlStats.dupReplies++;
+}
+
 } // namespace qlaodv
